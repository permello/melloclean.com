# Appwrite backend the server (BFF) talks to.
# Dev: use your Appwrite Cloud project's values.
# Prod: use the self-hosted Appwrite VPS's values.
APPWRITE_PROJECT_ID=
APPWRITE_PROJECT_NAME=
APPWRITE_ENDPOINT=
# Server-only Appwrite key with the `sessions.write` scope. The legacy
# APPWRITE_ACCOUNT_CREATION_API_KEY name is also accepted during migration.
APPWRITE_SESSION_API_KEY=

# Port the server (BFF) listens on.
# PORT=5000

# Comma-separated list of full origins (scheme + host, no trailing slash)
# allowed to make credentialed cross-origin requests to the server.
# Unset or empty means no origin is permitted (fail-closed).
# Example: CORS_ORIGINS=http://www.127.0.0.1.nip.io,http://app.127.0.0.1.nip.io
CORS_ORIGINS=

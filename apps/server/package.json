{
  "name": "@permello/server",
  "private": true,
  "scripts": {
    "dev": "dotnet watch --project MelloClean.Server/MelloClean.Server.csproj run",
    "build": "dotnet build MelloClean.Server.sln --configuration Release --disable-build-servers --maxcpucount:1",
    "typecheck": "dotnet build MelloClean.Server.sln --configuration Release --disable-build-servers --maxcpucount:1 --no-restore /warnaserror",
    "lint": "dotnet format MelloClean.Server.sln --verify-no-changes --no-restore",
    "test": "dotnet test MelloClean.Server.sln --configuration Release --disable-build-servers --maxcpucount:1"
  }
}

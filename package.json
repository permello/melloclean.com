{
  "name": "melloclean",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "npm@11.18.0",
  "description": "A responsive and modern website built for my cleaning business",
  "homepage": "https://github.com/permello/melloclean.com#readme",
  "bugs": {
    "url": "https://github.com/permello/melloclean.com/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/permello/melloclean.com.git"
  },
  "license": "MIT",
  "author": "Eduardo Turcios",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "dev:dock": "docker-compose -f docker-compose.yml --profile dev up --no-recreate -d",
    "prod:dock": "docker-compose -f docker-compose.yml --profile prod up --no-recreate -d",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "docker:rebuild": "turbo run docker:rebuild --output-logs=new-only",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "copyright": "node scripts/copyright.mjs",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf {} +",
    "refresh": "npm run clean ; find . -name 'package-lock.json' -delete ; ncu --workspaces --root -u && npm install"
  },
  "devDependencies": {
    "turbo": "^2.10.2",
    "typescript": "^6.0.3",
    "prettier": "^3.9.4"
  }
}